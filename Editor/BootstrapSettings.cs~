using System;
using System.IO;
using UnityEngine;
using UnityEditor.PackageManager;
using UnityEditor;

public namespace VK.Bootstrap
{
	static class BootstrapSettingsProvider
	{
		private static string PackageName => "com.vladislav-kostin.nice-bootstrap";
		private static string SettingsPath => Path.Combine(Application.dataPath, "Library/PackageCache/com.vladislav-kostin.nice-bootstrap/Settings/BootstrapSettings.json");
// "C:\Users\Home\Desktop\NiceBootstrap\Settings\Settings.json"
		[SettingsProvider]
		public static SettingsProvider CreateBootstrapSettingsProvider()
		{
			return new SettingsProvider("Project/BootstrapSettings", SettingsScope.Project)
			{
				label = "Bootstrap Settings",
				guiHandler = (searchContext) =>
				{
					var settings = LoadSettings();
					EditorGUI.BeginChangeCheck();
					settings.bootstrapFolderPath = EditorGUILayout.TextField("Bootstrap Folder Path", settings.bootstrapFolderPath);
					if (EditorGUI.EndChangeCheck())
					{
						SaveSettings(settings);
					}
				}
			};
		}

		private static Settings LoadSettings()
		{
			if (File.Exists(SettingsPath))
			{
				string json = File.ReadAllText(SettingsPath);
				return JsonUtility.FromJson<BootstrapSettings>(json);
			}

			return new Settings();
		}

		private static void SaveSettings(BootstrapSettings settings)
		{
			string json = JsonUtility.ToJson(settings, prettyPrint: true);
			File.WriteAllText(SettingsPath, json);
		}

		private static string GetSettingsPath()
		{
			return Path.Combine(PackageUtility.GetPackageInstallPath(PackageName), "BootstrapSettings.json");
		}
	}
}